# Base de données. En local : file:./dev.db (relatif à prisma/).
# En Docker : file:/data/rwaresto.db (valeur forcée par docker-compose.yml)
DATABASE_URL="file:./dev.db"

# Compte administrateur initial, créé uniquement au premier démarrage.
# Utilisez un mot de passe unique et long, puis changez-le depuis l'interface.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changez-moi-absolument"

# Secret de signature des sessions (générer avec : openssl rand -base64 48)
# Obligatoire, 24 caractères minimum.
SESSION_SECRET="remplacez-par-un-secret-long-et-aleatoire"

# URL publique du site (sans slash final)
SITE_URL="https://rwaresto.rwazap.com"

# Devise ISO 4217 initiale et locale de formatage
CURRENCY="EUR"
LOCALE="fr-FR"

# Port local du conteneur sur le VPS (écoute sur 127.0.0.1 uniquement)
HOST_PORT=3107

# Dossier des photos téléversées (dans le volume Docker)
UPLOAD_DIR="/data/uploads"

# Limites anti-spam (création de commandes)
ORDER_RATE_LIMIT=8
ORDER_RATE_WINDOW_SECONDS=60
