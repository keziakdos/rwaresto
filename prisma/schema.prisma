generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  displayName        String
  passwordHash       String
  role               String     @default("cashier") // admin | cashier
  active             Boolean    @default(true)
  mustChangePassword Boolean    @default(true)
  sessionVersion     Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  validatedOrders Order[]    @relation("ValidatedBy")
  readyOrders     Order[]    @relation("ReadyBy")
  paidOrders      Order[]    @relation("PaidBy")
  auditLogs       AuditLog[]

  @@index([role, active])
}

model DiningTable {
  id        String   @id @default(cuid())
  number    Int      @unique
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Table")
}

model Category {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  image             String?
  availableFrom     String?
  availableTo       String?
  availableFromDate String?
  availableToDate   String?
  sortOrder         Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@index([active, sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  priceCents  Int
  image       String?
  categoryId  String
  available   Boolean  @default(true)
  hidden      Boolean  @default(false)
  archived    Boolean  @default(false)
  vegetarian  Boolean  @default(false)
  vegan       Boolean  @default(false)
  spicy       Boolean  @default(false)
  halal       Boolean  @default(false)
  isNew       Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])
  optionGroups ProductOptionGroup[]
  orderItems  OrderItem[]

  @@index([categoryId, archived, hidden, sortOrder])
}

model OptionGroup {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("single") // single | multiple
  required      Boolean  @default(false)
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  choices       OptionChoice[]
  products      ProductOptionGroup[]
}

model OptionChoice {
  id               String      @id @default(cuid())
  optionGroupId    String
  name             String
  priceDeltaCents  Int         @default(0)
  available        Boolean     @default(true)
  sortOrder        Int         @default(0)
  optionGroup      OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId, sortOrder])
}

model ProductOptionGroup {
  productId     String
  optionGroupId String
  sortOrder     Int         @default(0)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@id([productId, optionGroupId])
  @@index([optionGroupId])
}

model Order {
  id                       String    @id @default(cuid())
  publicToken              String    @unique @default(cuid())
  orderNumber              String
  dayKey                   String
  status                   String    @default("submitted") // submitted | in_progress | ready | completed | cancelled
  mode                     String    @default("dine_in") // dine_in | takeaway
  tableNumber              Int?
  customerName             String
  customerNameNormalized   String
  phone                    String?
  note                     String?
  cancelReason             String?
  subtotalCents            Int
  totalCents               Int
  paymentStatus            String    @default("unpaid") // unpaid | paid
  paymentMethod            String? // cash | card
  idempotencyKey           String?   @unique
  clientId                 String?
  submittedAt              DateTime  @default(now())
  validatedAt              DateTime?
  readyAt                  DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  validatedById            String?
  readyById                String?
  paidById                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  validatedBy User?       @relation("ValidatedBy", fields: [validatedById], references: [id])
  readyBy     User?       @relation("ReadyBy", fields: [readyById], references: [id])
  paidBy      User?       @relation("PaidBy", fields: [paidById], references: [id])
  items       OrderItem[]
  auditLogs   AuditLog[]

  @@unique([dayKey, orderNumber])
  @@index([status, submittedAt])
  @@index([dayKey, status])
  @@index([tableNumber, status])
  @@index([customerNameNormalized, status])
  @@index([clientId, status])
  @@index([paymentStatus, completedAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  nameSnapshot    String
  unitPriceCents  Int
  quantity        Int
  note            String?
  lineTotalCents  Int
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id])
  options         OrderItemOption[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemOption {
  id                String    @id @default(cuid())
  orderItemId       String
  groupNameSnapshot String
  choiceNameSnapshot String
  priceDeltaCents   Int       @default(0)
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  orderId    String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([entityType, createdAt])
  @@index([actorId, createdAt])
  @@index([orderId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
